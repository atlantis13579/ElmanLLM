{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    { "name": "windows-vs2022", "displayName": "Visual Studio 2022 CPU + Compute", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/Build/vs2022", "cacheVariables": { "ELMAN_ENABLE_COMPUTE": "ON" } },
    { "name": "windows-vs2022-cuda", "displayName": "Visual Studio 2022 CPU + CUDA + Compute", "inherits": "windows-vs2022", "binaryDir": "${sourceDir}/Build/vs2022-cuda", "cacheVariables": { "ELMAN_ENABLE_CUDA": "ON", "CMAKE_CUDA_ARCHITECTURES": "89" } },
    { "name": "windows-cuda", "displayName": "Windows CUDA (developer command prompt)", "generator": "Ninja", "binaryDir": "${sourceDir}/Build/windows-cuda", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ELMAN_ENABLE_CUDA": "ON", "ELMAN_ENABLE_COMPUTE": "ON", "CMAKE_CUDA_ARCHITECTURES": "89" } },
    { "name": "linux", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/Build/linux", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ELMAN_ENABLE_COMPUTE": "OFF", "ELMAN_ENABLE_METAL": "OFF" } },
    { "name": "linux-cuda", "inherits": "linux", "binaryDir": "${sourceDir}/Build/linux-cuda", "cacheVariables": { "ELMAN_ENABLE_CUDA": "ON" } },
    { "name": "macos-xcode", "generator": "Xcode", "binaryDir": "${sourceDir}/Build/xcode", "cacheVariables": { "ELMAN_ENABLE_METAL": "ON", "ELMAN_ENABLE_COMPUTE": "OFF" } }
  ],
  "buildPresets": [
    { "name": "windows-vs2022", "configurePreset": "windows-vs2022", "configuration": "Release" },
    { "name": "windows-vs2022-cuda", "configurePreset": "windows-vs2022-cuda", "configuration": "Release", "jobs": 6 },
    { "name": "windows-cuda", "configurePreset": "windows-cuda", "jobs": 6 },
    { "name": "linux", "configurePreset": "linux", "jobs": 4 },
    { "name": "linux-cuda", "configurePreset": "linux-cuda", "jobs": 4 },
    { "name": "macos-xcode", "configurePreset": "macos-xcode", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-vs2022", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022-cuda", "configurePreset": "windows-vs2022-cuda", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-cuda", "configurePreset": "windows-cuda", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "linux-cuda", "configurePreset": "linux-cuda", "output": { "outputOnFailure": true } },
    { "name": "macos-xcode", "configurePreset": "macos-xcode", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
