{
  "format": "elman.model",
  "version": 2,
  "name": "LinearRegression",
  "architecture": "linear_regression",
  "task": "regression",
  "parameters": {
    "input_features": 10,
    "classes": 1
  },
  "output_features": "$classes",
  "inputs": [
    {
      "name": "input",
      "dtype": "float32",
      "shape": [
        -1,
        "$input_features"
      ]
    }
  ],
  "outputs": [
    {
      "name": "output",
      "value": "network",
      "dtype": "float32",
      "shape": [
        -1,
        "$classes"
      ]
    }
  ],
  "layers": [
    {
      "name": "network",
      "class_name": "Linear",
      "config": {
        "in_features": "$input_features",
        "out_features": "$classes"
      },
      "inputs": [
        "input"
      ]
    }
  ]
}
