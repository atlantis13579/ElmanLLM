{
  "format": "elman.training",
  "version": 1,
  "model_name": "AlexNet",
  "model": "../Models/AlexNet.json",
  "backend": "cuda",
  "data": {
    "format": "image_csv",
    "path": "../Data/alexnet_sample.csv",
    "limit_samples": 1
  },
  "training": {
    "steps": 1,
    "batch_size": 1,
    "optimizer": "adam",
    "learning_rate": 1e-05,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08,
    "momentum": 0.0,
    "weight_decay": 0.0,
    "clip_grad_norm": 1.0,
    "seed": 42,
    "shuffle": false,
    "log_every": 1,
    "checkpoint_every": 0,
    "lr_schedule": "constant",
    "warmup_steps": 0,
    "min_lr_ratio": 0.1,
    "require_loss_decrease": false
  },
  "output": {
    "checkpoint": "../Intermediate/Runs/alexnet_full/model.elman",
    "metrics": "../Intermediate/Runs/alexnet_full/metrics.json",
    "graph": "../Intermediate/Runs/alexnet_full/graph.json"
  }
}
