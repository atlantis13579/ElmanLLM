foreach(required ELMAN_EXECUTABLE ELMAN_SOURCE_DIR ELMAN_MODEL ELMAN_BACKEND)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing smoke test setting: ${required}")
    endif()
endforeach()
set(run "${ELMAN_SOURCE_DIR}/Intermediate/CTest/${ELMAN_MODEL}-full-${ELMAN_BACKEND}")
file(MAKE_DIRECTORY "${run}")
file(READ "${ELMAN_SOURCE_DIR}/Configs/${ELMAN_MODEL}_smoke.json" config)
string(JSON model_path GET "${config}" model)
string(JSON data_path GET "${config}" data path)
get_filename_component(model_path "${model_path}" ABSOLUTE BASE_DIR "${ELMAN_SOURCE_DIR}/Configs")
get_filename_component(data_path "${data_path}" ABSOLUTE BASE_DIR "${ELMAN_SOURCE_DIR}/Configs")
string(JSON config SET "${config}" model "\"${model_path}\"")
string(JSON config SET "${config}" data path "\"${data_path}\"")
string(JSON config SET "${config}" backend "\"${ELMAN_BACKEND}\"")
string(JSON config SET "${config}" output checkpoint "\"${run}/model.elman\"")
string(JSON config SET "${config}" output metrics "\"${run}/metrics.json\"")
string(JSON config SET "${config}" output graph "\"${run}/graph.json\"")
file(WRITE "${run}/config.json" "${config}\n")

function(run_stage stage)
    message(STATUS "${ELMAN_MODEL}/${ELMAN_BACKEND}: ${stage}; log=${run}/${stage}.log")
    execute_process(COMMAND "${ELMAN_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_FILE "${run}/${stage}.log" ERROR_FILE "${run}/${stage}.error.log")
    if(NOT result EQUAL 0)
        file(READ "${run}/${stage}.log" output)
        file(READ "${run}/${stage}.error.log" error)
        message(FATAL_ERROR "${stage} failed (${result}):\n${output}\n${error}")
    endif()
endfunction()

run_stage(train train "${run}/config.json")
file(READ "${run}/metrics.json" metrics)
string(JSON initial GET "${metrics}" initial_eval_loss)
string(JSON final GET "${metrics}" final_eval_loss)
string(JSON changed GET "${metrics}" changed_parameter_tensors)
string(JSON parameters GET "${metrics}" parameter_tensors)
string(JSON dispatches GET "${metrics}" backend_dispatches)
string(JSON roundtrip GET "${metrics}" checkpoint_roundtrip_max_error)
string(JSON weight_count GET "${metrics}" parameters)
if(ELMAN_MODEL STREQUAL "alexnet")
    set(expected_weights 61100840)
else()
    set(expected_weights 124439808)
endif()
if(NOT weight_count EQUAL expected_weights OR changed LESS 1 OR dispatches LESS 1 OR roundtrip GREATER 0.000001)
    message(FATAL_ERROR "Training invariants failed: ${metrics}")
endif()
run_stage(infer infer "${run}/config.json" --output "${run}/inference.json")
message(STATUS "${ELMAN_MODEL}/${ELMAN_BACKEND}: ${weight_count} weights; loss ${initial} -> ${final}; ${changed}/${parameters} parameter tensors updated; checkpoint and inference passed")
